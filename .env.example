# NimbleLLM configuration.
#
# Copy to .env and fill in only the providers you actually use — configuring
# one does not oblige you to configure the rest. Routing to a provider with no
# credentials fails with `authentication_error` naming the variables it wanted.
#
# v1 is single-instance: one deployment holds one set of credentials. There is
# no per-caller credential routing.

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com     # a proxy or compatible gateway
# OPENAI_ORG_ID=org-...
# OPENAI_PROJECT_ID=proj_...

# --- Anthropic ---------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # a proxy or compatible gateway
# ANTHROPIC_VERSION=2023-06-01                   # the anthropic-version header

# --- Azure OpenAI ------------------------------------------------------------
# The model reference is the DEPLOYMENT name: azure/my-gpt4o-deployment
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ACCESS_TOKEN=...              # Entra ID token, instead of a key
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- AWS Bedrock -------------------------------------------------------------
# AWS_REGION=us-east-1
#
# Either a Bedrock API key (simplest) ...
# AWS_BEARER_TOKEN_BEDROCK=...
#
# ... or IAM credentials, which are signed with SigV4:
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...                      # only for temporary credentials
# BEDROCK_BASE_URL=                          # override the regional endpoint

# --- Google Vertex AI --------------------------------------------------------
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=us-central1
#
# Either a service account key, from which tokens are minted and cached ...
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# ... or a token you refresh yourself:
# GOOGLE_ACCESS_TOKEN=ya29....

# --- Client behaviour --------------------------------------------------------
# NIMBLE_DEFAULT_PROVIDER=openai             # for models with no provider/ prefix
# NIMBLE_TIMEOUT_MS=120000                   # per attempt
# NIMBLE_MAX_RETRIES=2                       # retryable failures only
